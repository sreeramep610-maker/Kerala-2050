// Kerala 2050 - backend that connects the chatbot to Claude.
// The API key stays on the server (never in the browser).
import express from "express";
import Anthropic from "@anthropic-ai/sdk";
import path from "node:path";
import { fileURLToPath } from "node:url";

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const app = express();
app.use(express.json({ limit: "20kb" }));
app.use(express.static(__dirname, { index: "index.html" }));

const MODEL = process.env.CLAUDE_MODEL || "claude-sonnet-5-5";
const client = process.env.ANTHROPIC_API_KEY ? new Anthropic() : null;

const SYSTEM_PROMPT = `You are "Kerala AI", the citizen assistant of the Kerala 2050 project:
an AI-powered digital heritage museum and smart future city concept for Kerala, India.
You help visitors with: Kerala's culture and history (Kathakali, Theyyam, Kalaripayattu,
Mohiniyattam, Onam, spice trade, backwaters), the 14 districts, and imaginative but
realistic ideas for Kerala in 2050 (renewable energy, smart transport, AI healthcare,
sustainable tourism, digital governance).
Rules: keep answers friendly and under 120 words unless asked for more; use simple language;
clearly label future ideas as vision/concepts, not facts; if you are unsure of a fact, say so;
politely steer unrelated questions back to Kerala or the project.`;

// Very small in-memory rate limiter: 20 requests / minute / IP
const hits = new Map();
function rateLimit(req, res, next) {
  const now = Date.now();
  const arr = (hits.get(req.ip) || []).filter((t) => now - t < 60_000);
  if (arr.length >= 20) return res.status(429).json({ error: "Too many requests, slow down." });
  arr.push(now);
  hits.set(req.ip, arr);
  next();
}

app.post("/api/chat", rateLimit, async (req, res) => {
  if (!client) {
    return res.status(503).json({ error: "Server has no ANTHROPIC_API_KEY configured." });
  }
  const raw = Array.isArray(req.body?.messages) ? req.body.messages : [];
  // Keep only valid roles, trim length, keep the last 12 turns
  const messages = raw
    .filter((m) => (m.role === "user" || m.role === "assistant") && typeof m.content === "string")
    .map((m) => ({ role: m.role, content: m.content.slice(0, 1500) }))
    .slice(-12);
  if (!messages.length || messages[messages.length - 1].role !== "user") {
    return res.status(400).json({ error: "Send at least one user message." });
  }
  try {
    const response = await client.messages.create({
      model: MODEL,
      max_tokens: 500,
      system: SYSTEM_PROMPT,
      messages,
    });
    const reply = response.content.filter((b) => b.type === "text").map((b) => b.text).join("\n");
    res.json({ reply });
  } catch (err) {
    console.error("Claude API error:", err.message);
    res.status(502).json({ error: "The AI service is unavailable right now." });
  }
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log(`Kerala 2050 running on http://localhost:${PORT}`));
